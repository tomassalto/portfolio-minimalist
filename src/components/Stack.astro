---
import { MY_STACK } from "@/helpers/staticData.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const groups = [
  { title: "Frontend", items: MY_STACK.frontend },
  { title: "Backend", items: MY_STACK.backend },
  { title: t("skills.learn"), items: MY_STACK.learning },
  { title: t("skills.tools"), items: MY_STACK.tools },
];
---

<div class="grid gap-4 md:grid-cols-2">
  {
    groups.map((group) => (
      <article class="section-shell rounded-[1.75rem] p-6">
        <h3 class="stack-group-title-text">{group.title}</h3>
        <div class="mt-5 flex flex-wrap gap-3">
          {group.items.map((tech) => (
            <div
              class="stack-item-text inline-flex items-center gap-2 rounded-full border px-4 py-2"
              style="border-color: var(--border); background: var(--surface-strong);"
            >
              <tech.icon class="size-4" />
              <span>{tech.name}</span>
            </div>
          ))}
        </div>
      </article>
    ))
  }
</div>
