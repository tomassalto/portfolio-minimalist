---
import { categoryLabels } from "@/data/portfolio";
import { getPortfolioProjects } from "@/lib/github";
import { siteConfig } from "@/config/site";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { defaultLang, type Language } from "@/i18n/ui";
import GitHubIcon from "./icons/GitHub.astro";
import LinkIcon from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import type { PortfolioProject, ProjectCategory } from "@/types";

const lang = getLangFromUrl(Astro.url) as Language;
const t = useTranslations(lang);
const projects = await getPortfolioProjects(lang);

const featuredProjects = projects
  .filter((project) => project.featured)
  .sort((a, b) => (a.featuredOrder ?? 999) - (b.featuredOrder ?? 999));
const recentProjects = projects.slice(0, 6);

const filters: Array<{ key: "all" | ProjectCategory; label: string }> = [
  { key: "all", label: t("projects.filterAll") },
  ...Object.entries(categoryLabels).map(([key, value]) => ({
    key: key as ProjectCategory,
    label: value[lang] ?? value[defaultLang],
  })),
];

const dateFormatter = new Intl.DateTimeFormat(
  lang === "en" ? "en-US" : "es-AR",
  {
    year: "numeric",
    month: "short",
    day: "numeric",
  },
);

const renderDate = (value: string | null) =>
  value ? dateFormatter.format(new Date(value)) : t("projects.updatedUnavailable");
const projectCategories = (project: PortfolioProject) =>
  project.categories.join(" ");
---

<div class="space-y-20 lg:space-y-28" data-projects-root>
  <div class="flex flex-wrap gap-2">
    {
      filters.map((filter) => (
        <button
          type="button"
          data-filter={filter.key}
          aria-pressed={filter.key === "all" ? "true" : "false"}
          class:list={[
            "filter-pill projects-filter-text rounded-full border px-4 py-2",
            filter.key === "all" && "is-active",
          ]}
        >
          {filter.label}
        </button>
      ))
    }
  </div>

  <section
    id="destacados"
    class="scroll-mt-44 space-y-5 lg:scroll-mt-52"
    data-project-group
  >
    <div class="flex flex-col gap-2">
      <h2 class="eyebrow section-title-eyebrow">
        {t("featured.title")}
      </h2>
      <p class="projects-intro-text muted max-w-3xl">{t("featured.copy")}</p>
    </div>
    <div class="grid gap-6">
      {
        featuredProjects.map((project) => (
          <article
            class="project-card section-shell overflow-hidden rounded-[2rem]"
            data-categories={projectCategories(project)}
            data-group="featured"
          >
            <div class="flex h-full flex-col">
              <div class="relative m-3 overflow-hidden rounded-[1.5rem] min-h-56 md:min-h-80">
                {project.image ? (
                  <img
                    src={project.image}
                    alt={project.name}
                    class="h-full w-full object-contain bg-black/5 p-3 transition duration-300 ease-out hover:scale-[1.03] dark:bg-white/5"
                    loading="lazy"
                  />
                ) : (
                  <div class="h-full w-full bg-[radial-gradient(circle_at_top,rgba(52,211,153,0.3),transparent_40%),linear-gradient(135deg,#0f172a,#1f2937)]" />
                )}
              </div>
              <div class="space-y-4 p-6 lg:space-y-5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="projects-featured-badge-text rounded-full bg-black px-3 py-1 text-white dark:bg-white dark:text-black">
                    {t("projects.featuredBadge")}
                  </span>
                  {project.categories.map((category) => (
                    <span
                      class="projects-featured-category-text project-pill rounded-full border px-3 py-1"
                    >
                      {categoryLabels[category][lang]}
                    </span>
                  ))}
                </div>
                <div class="space-y-3">
                  <h3 class="projects-featured-title-text">{project.name}</h3>
                  <p class="projects-featured-description-text muted">{project.description}</p>
                </div>
                <dl class="projects-featured-meta-text grid gap-4 muted lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
                  <div class="space-y-1">
                    <dt class="projects-featured-meta-label">{t("projects.whatItShows")}</dt>
                    <dd>{project.summary}</dd>
                  </div>
                  <div class="space-y-1">
                    <dt class="projects-featured-meta-label">{t("projects.stack")}</dt>
                    <dd>{project.technologies.join(" / ")}</dd>
                  </div>
                  <div class="space-y-1 lg:col-span-2">
                    <dt class="projects-featured-meta-label">{t("projects.updated")}</dt>
                    <dd>{renderDate(project.updatedAt)}</dd>
                  </div>
                </dl>
                <div class="flex flex-wrap gap-3">
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="projects-featured-link-text inline-flex items-center gap-2 hover:underline"
                  >
                    <GitHubIcon class="size-4" />
                    {t("projects.code")}
                  </a>
                  {project.deployUrl && (
                    <a
                      href={project.deployUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="projects-featured-link-text inline-flex items-center gap-2 hover:underline"
                    >
                      <LinkIcon class="size-4" />
                      {t("projects.deploy")}
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    id="proyectos"
    class="scroll-mt-44 space-y-5 lg:scroll-mt-52"
    data-project-group
  >
    <div class="flex flex-col gap-2">
      <h2 class="eyebrow section-title-eyebrow">
        {t("projects.title")}
      </h2>
      <p class="projects-intro-text muted max-w-3xl">{t("projects.copy")}</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        recentProjects.map((project) => (
          <article
            class="project-card section-shell flex h-full flex-col rounded-[1.75rem] p-5"
            data-categories={projectCategories(project)}
            data-group="all"
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="projects-card-title-text">{project.name}</h3>
                <p class="projects-card-description-text mt-2 muted">{project.description}</p>
              </div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.technologies.map((technology) => (
                <span
                  class="projects-card-tech-text project-pill rounded-full border px-3 py-1"
                >
                  {technology}
                </span>
              ))}
            </div>
            <p class="projects-card-meta-text mt-4 muted">
              <span class="projects-card-meta-label">{t("projects.summary")}:</span>{" "}
              {project.summary}
            </p>
            <div class="projects-card-meta-text mt-4 muted">
              <span class="projects-card-meta-label">{t("projects.updated")}:</span>{" "}
              {renderDate(project.updatedAt)}
            </div>
            <div class="mt-auto flex flex-wrap gap-3 pt-5">
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noreferrer"
                class="projects-card-link-text inline-flex items-center gap-2 hover:underline"
              >
                <GitHubIcon class="size-4" />
                {t("projects.code")}
              </a>
              {project.deployUrl && (
                <a
                  href={project.deployUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="projects-card-link-text inline-flex items-center gap-2 hover:underline"
                >
                  <LinkIcon class="size-4" />
                  {t("projects.deploy")}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
    <div class="flex justify-center pt-2">
      <LinkButton href={`${siteConfig.githubUrl}?tab=repositories`}>
        <span class="projects-cta-text">{t("projects.viewAll")}</span>
      </LinkButton>
    </div>
    <p class="projects-empty-text hidden muted" data-empty-message>{t("projects.empty")}</p>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-projects-root]");
  const buttons = root?.querySelectorAll<HTMLElement>("[data-filter]");
  const cards = root?.querySelectorAll<HTMLElement>(".project-card");
  const emptyMessage = root?.querySelector<HTMLElement>("[data-empty-message]");

  const updateFilter = (filter: string) => {
    let visibleCount = 0;

    buttons?.forEach((button) => {
      button.classList.toggle("is-active", button.dataset.filter === filter);
      button.setAttribute(
        "aria-pressed",
        button.dataset.filter === filter ? "true" : "false",
      );
    });

    cards?.forEach((card) => {
      const categories = card.dataset.categories?.split(" ") ?? [];
      const visible = filter === "all" || categories.includes(filter);
      card.classList.toggle("hidden", !visible);
      if (visible && card.dataset.group === "all") {
        visibleCount += 1;
      }
    });

    emptyMessage?.classList.toggle("hidden", visibleCount !== 0);
  };

  updateFilter("all");

  buttons?.forEach((button) => {
    button.addEventListener("click", () => {
      updateFilter(button.dataset.filter ?? "all");
    });
  });
</script>
