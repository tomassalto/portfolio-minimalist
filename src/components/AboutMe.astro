---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const highlights =
  lang === "en"
    ? [
        "Front-end focused on user experience and performance.",
        "PHP/Laravel backend with business logic and persistence.",
        "Experience integrating APIs, deployments, and continuous maintenance.",
      ]
    : [
        "Front-end con foco en experiencia de usuario y performance.",
        "Backend en PHP/Laravel con lógica de negocio y persistencia.",
        "Experiencia integrando APIs, despliegues y mantenimiento continuo.",
      ];
---

<article class="about-shell">
  <div class="section-shell rounded-[2rem] p-6 md:p-8">
    <div
      class="about-copy-text max-w-none"
      set:html={t("about.copy")}
    />
  </div>
  <div class="section-shell rounded-[2rem] p-6">
    <h3 class="about-side-title-text mb-4">
      {lang === "en" ? "How I work" : "Cómo trabajo"}
    </h3>
    <div class="about-highlight-text space-y-3 muted">
      {highlights.map((highlight) => <p>{highlight}</p>)}
    </div>
  </div>
</article>
