---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { siteConfig } from "@/config/site";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const cvPath = siteConfig.cvPath[lang];
---

<footer class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
  <div class="section-shell flex flex-col gap-4 rounded-[1.75rem] px-6 py-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="footer-copy-text">© {currentYear} {siteConfig.name}</p>
      <p class="footer-meta-text mt-1 muted">{t("footer.copy")}</p>
    </div>
    <div id="contacto" class="flex flex-wrap gap-3">
      <a href={siteConfig.githubUrl} target="_blank" rel="noreferrer" class="footer-link-text hover:underline">GitHub</a>
      <a href={siteConfig.linkedinUrl} target="_blank" rel="noreferrer" class="footer-link-text hover:underline">LinkedIn</a>
      <a href={`mailto:${siteConfig.email}`} class="footer-link-text hover:underline">{t("nav.contact")}</a>
      <a href={cvPath} class="footer-link-text hover:underline">{t("nav.cv")}</a>
    </div>
  </div>
</footer>
