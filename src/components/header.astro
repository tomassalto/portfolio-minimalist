---
import ThemeToggle from "./ThemeToggle.astro";
import LanguagePicker from "./LanguagePicker.astro";
import LinkButton from "./LinkButton.astro";
import { siteConfig } from "@/config/site";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { currentLocale } = Astro;
const cvPath = siteConfig.cvPath[lang];

const navItems = [
  {
    title: t("nav.experience"),
    section: "experiencia",
    url: currentLocale === "en" ? "/en#experiencia" : "/#experiencia",
  },
  {
    title: t("nav.featured"),
    section: "destacados",
    url: currentLocale === "en" ? "/en#destacados" : "/#destacados",
  },
  {
    title: t("nav.projects"),
    section: "proyectos",
    url: currentLocale === "en" ? "/en#proyectos" : "/#proyectos",
  },
  {
    title: t("nav.about"),
    section: "sobre-mi",
    url: currentLocale === "en" ? "/en#sobre-mi" : "/#sobre-mi",
  },
  {
    title: t("nav.skills"),
    section: "tecnologias",
    url: currentLocale === "en" ? "/en#tecnologias" : "/#tecnologias",
  },
];
---

<header class="sticky top-0 z-20 mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
  <nav
    aria-label="Primary"
    class="section-shell rounded-[1.75rem] px-4 py-3"
  >
    <div class="flex items-center justify-between gap-3">
      <a href={currentLocale === "en" ? "/en/" : "/"} class="header-brand-text">
        {siteConfig.name}
      </a>

      <div class="hidden items-center gap-1 md:flex lg:gap-3">
        {
          navItems.map((link) => (
            <a
              class="header-nav-text rounded-full px-3 py-2 transition hover:bg-black/5 hover:text-[var(--accent-strong)] dark:hover:bg-white/5"
              data-section={link.section}
              href={link.url}
            >
              {link.title}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-2">
        <div class="hidden md:block">
          <LinkButton href={cvPath}>{t("nav.cv")}</LinkButton>
        </div>
        <ThemeToggle />
        <LanguagePicker />
        <button
          type="button"
          class="header-menu-button md:hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
          data-menu-toggle
        >
          <span class="sr-only">Open menu</span>
          <span class="header-menu-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden" data-mobile-menu>
      <div class="mt-4 grid gap-2 border-t pt-4" style="border-color: var(--border);">
        {
          navItems.map((link) => (
            <a
              class="header-mobile-link"
              data-section={link.section}
              href={link.url}
            >
              {link.title}
            </a>
          ))
        }
        <a href={cvPath} class="header-mobile-link">
          {t("nav.cv")}
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const bindMobileMenu = () => {
      const button = document.querySelector("[data-menu-toggle]");
      const menu = document.querySelector("[data-mobile-menu]");
      const links = menu?.querySelectorAll("a") ?? [];

      if (!button || !menu || button.dataset.bound === "true") {
        return;
      }

      const setOpen = (open) => {
        button.setAttribute("aria-expanded", String(open));
        menu.classList.toggle("hidden", !open);
      };

      button.dataset.bound = "true";
      button.addEventListener("click", () => {
        setOpen(button.getAttribute("aria-expanded") !== "true");
      });

      links.forEach((link) => {
        link.addEventListener("click", () => setOpen(false));
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setOpen(false);
        }
      });
    };

    const runScrollSpy = () => {
      const sections = document.querySelectorAll("section[id]");
      const navItems = document.querySelectorAll("header nav a[data-section]");

      if (!sections.length || !navItems.length) {
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = entry.target.getAttribute("id");

            navItems.forEach((item) => {
              item.classList.toggle(
                "!text-[var(--accent-strong)]",
                item.getAttribute("data-section") === id,
              );
            });
          });
        },
        {
          root: null,
          rootMargin: "-15% 0px -45% 0px",
          threshold: 0.1,
        },
      );

      sections.forEach((section) => observer.observe(section));
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        bindMobileMenu();
        runScrollSpy();
      }, { once: true });
    } else {
      bindMobileMenu();
      runScrollSpy();
    }
  })();
</script>
