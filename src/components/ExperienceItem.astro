---
import type { Props } from "@/types";

const { title, company, description, date } = Astro.props as Props;
---

<article class="section-shell rounded-[1.5rem] p-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="experience-role-text">{title}</p>
      <p class="experience-company-text muted">{company}</p>
    </div>
    <time class="experience-date-text muted">{date}</time>
  </div>
  <p class="experience-description-text mt-4 muted">{description}</p>
</article>
