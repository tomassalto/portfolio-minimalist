---
import type { Props } from "@/types";

const { href } = Astro.props as Props;
const external = href?.startsWith("http") || href?.startsWith("mailto:");
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
  class="inline-flex items-center justify-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2"
  style="border-color: var(--border); background: var(--surface-strong); color: var(--text);"
>
  <slot />
</a>
