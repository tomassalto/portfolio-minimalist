---
import "@fontsource-variable/onest/wght.css";
import "@/styles/global.css";
import Header from "../components/header.astro";
import Footer from "../components/Footer.astro";
import { languages } from "@/i18n/ui";
import { siteConfig } from "@/config/site";

const { currentLocale } = Astro;

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const personStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  jobTitle: siteConfig.role,
  address: {
    "@type": "PostalAddress",
    addressLocality: siteConfig.location,
    addressCountry: "AR",
  },
  email: `mailto:${siteConfig.email}`,
  sameAs: [siteConfig.githubUrl, siteConfig.linkedinUrl],
  url: canonical.toString(),
};
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: title,
  url: canonical.toString(),
  description,
  inLanguage: currentLocale,
};
---

<!doctype html>
<html lang={currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={new URL("/profile_1_40.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteStructuredData)} />
    {
      Object.keys(languages).map((lang) => (
        <link
          rel="alternate"
          hreflang={lang}
          href={new URL(lang === "es" ? "/" : `/${lang}/`, Astro.site).toString()}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).toString()} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storageKey = "theme";
        const stored = localStorage.getItem(storageKey);
        const theme =
          stored === "dark" || stored === "light"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();
    </script>
  </head>

  <body class="relative">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 min-h-screen w-full bg-gray-50 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(217,216,255,0.5),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <slot />
    </div>
    <Footer />
  </body>
</html>
